{
  "$id": "https://spec-speaker.local/schemas/v1/MetricsDashboardRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "baselineId": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "correlationId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "groupBy": {
      "enum": [
        "type",
        "level",
        "owner",
        "priority",
        "criticality",
        "release",
        "status",
        "verification-status"
      ]
    },
    "requirementIds": {
      "items": {
        "pattern": "^(BR|SR)-[0-9]{6}$",
        "type": "string"
      },
      "maxItems": 500,
      "type": "array",
      "uniqueItems": true
    },
    "schemaVersion": {
      "const": "1.0.0"
    }
  },
  "required": [
    "schemaVersion",
    "correlationId",
    "groupBy"
  ],
  "title": "MetricsDashboardRequest",
  "type": "object"
}
