{
  "$id": "https://spec-speaker.local/schemas/v1/ReuseAdoptRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "applicability": {
      "additionalProperties": true,
      "maxProperties": 32,
      "properties": {},
      "required": [],
      "type": "object"
    },
    "correlationId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "expectedRepositoryRevision": {
      "minimum": 0,
      "type": "integer"
    },
    "idempotencyKey": {
      "maxLength": 128,
      "minLength": 8,
      "type": "string"
    },
    "mode": {
      "enum": [
        "governed-reference",
        "controlled-clone"
      ]
    },
    "rationale": {
      "maxLength": 4000,
      "minLength": 1,
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "sourceExpectedVersion": {
      "minimum": 1,
      "type": "integer"
    },
    "sourceId": {
      "pattern": "^(BR|SR)-[0-9]{6}$",
      "type": "string"
    },
    "sourceLibrary": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "sourceRepository": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "correlationId",
    "idempotencyKey",
    "expectedRepositoryRevision",
    "sourceId",
    "sourceExpectedVersion",
    "mode",
    "sourceRepository",
    "applicability",
    "rationale"
  ],
  "title": "ReuseAdoptRequest",
  "type": "object"
}
