{
  "$id": "https://spec-speaker.local/schemas/v1/ChangeTriageRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "accountableOwner": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "changeId": {
      "pattern": "^CH-[0-9]{6}$",
      "type": "string"
    },
    "correlationId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "duplicateOf": {
      "pattern": "^CH-[0-9]{6}$",
      "type": "string"
    },
    "expectedRepositoryRevision": {
      "minimum": 0,
      "type": "integer"
    },
    "expectedVersion": {
      "minimum": 1,
      "type": "integer"
    },
    "idempotencyKey": {
      "maxLength": 128,
      "minLength": 8,
      "type": "string"
    },
    "issues": {
      "items": {
        "maxLength": 1000,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 128,
      "type": "array"
    },
    "schemaVersion": {
      "const": "1.0.0"
    }
  },
  "required": [
    "schemaVersion",
    "correlationId",
    "idempotencyKey",
    "expectedRepositoryRevision",
    "changeId",
    "expectedVersion",
    "accountableOwner"
  ],
  "title": "ChangeTriageRequest",
  "type": "object"
}
