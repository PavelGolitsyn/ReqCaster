{
  "$id": "https://spec-speaker.local/schemas/v1/ChangeAnalyzeRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "acceptTruncation": {
      "type": "boolean"
    },
    "assessments": {
      "additionalProperties": true,
      "maxProperties": 32,
      "properties": {},
      "required": [],
      "type": "object"
    },
    "changeId": {
      "pattern": "^CH-[0-9]{6}$",
      "type": "string"
    },
    "correlationId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "depth": {
      "maximum": 20,
      "minimum": 1,
      "type": "integer"
    },
    "expectedRepositoryRevision": {
      "minimum": 0,
      "type": "integer"
    },
    "expectedVersion": {
      "minimum": 1,
      "type": "integer"
    },
    "idempotencyKey": {
      "maxLength": 128,
      "minLength": 8,
      "type": "string"
    },
    "manuallyAddedImpacts": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "kind": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "version": {
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "kind",
          "id"
        ],
        "type": "object"
      },
      "maxItems": 1000,
      "type": "array"
    },
    "nodeLimit": {
      "maximum": 10000,
      "minimum": 1,
      "type": "integer"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "truncationRationale": {
      "maxLength": 4000,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "correlationId",
    "idempotencyKey",
    "expectedRepositoryRevision",
    "changeId",
    "expectedVersion"
  ],
  "title": "ChangeAnalyzeRequest",
  "type": "object"
}
