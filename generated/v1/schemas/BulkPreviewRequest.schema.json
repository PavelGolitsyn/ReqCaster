{
  "$id": "https://spec-speaker.local/schemas/v1/BulkPreviewRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "correlationId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "expectedRepositoryRevision": {
      "minimum": 0,
      "type": "integer"
    },
    "idempotencyKey": {
      "maxLength": 128,
      "minLength": 8,
      "type": "string"
    },
    "operations": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "operation": {
            "enum": [
              "create",
              "update",
              "retire",
              "link",
              "unlink",
              "transition"
            ]
          },
          "subjectId": {
            "maxLength": 128,
            "type": "string"
          }
        },
        "required": [
          "operation"
        ],
        "type": "object"
      },
      "maxItems": 500,
      "minItems": 1,
      "type": "array"
    },
    "schemaVersion": {
      "const": "1.0.0"
    }
  },
  "required": [
    "schemaVersion",
    "correlationId",
    "idempotencyKey",
    "expectedRepositoryRevision",
    "operations"
  ],
  "title": "BulkPreviewRequest",
  "type": "object"
}
