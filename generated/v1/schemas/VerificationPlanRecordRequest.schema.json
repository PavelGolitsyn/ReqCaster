{
  "$id": "https://speccaster.local/schemas/v1/VerificationPlanRecordRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "acceptanceCriteria": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "conditions": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "measurementMethod": {
            "maxLength": 1000,
            "minLength": 1,
            "type": "string"
          },
          "parameter": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "threshold": {
            "maxLength": 1000,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "parameter",
          "measurementMethod",
          "threshold",
          "conditions"
        ],
        "type": "object"
      },
      "maxItems": 128,
      "minItems": 1,
      "type": "array"
    },
    "configuration": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "correlationId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "dataset": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "environment": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "equipment": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "expectedRepositoryRevision": {
      "minimum": 0,
      "type": "integer"
    },
    "idempotencyKey": {
      "maxLength": 128,
      "minLength": 8,
      "type": "string"
    },
    "methods": {
      "items": {
        "enum": [
          "test",
          "demonstration",
          "inspection",
          "analysis"
        ]
      },
      "maxItems": 4,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "owner": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "procedure": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "uri": {
          "maxLength": 2048,
          "minLength": 1,
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "type": "object"
    },
    "rationale": {
      "maxLength": 4000,
      "minLength": 1,
      "type": "string"
    },
    "release": {
      "maxLength": 160,
      "minLength": 1,
      "type": "string"
    },
    "requirementId": {
      "pattern": "^(BR|SR)-[0-9]{6}$",
      "type": "string"
    },
    "requirementVersion": {
      "minimum": 1,
      "type": "integer"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "variant": {
      "maxLength": 160,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "correlationId",
    "idempotencyKey",
    "expectedRepositoryRevision",
    "requirementId",
    "requirementVersion",
    "methods",
    "acceptanceCriteria",
    "procedure",
    "owner",
    "configuration"
  ],
  "title": "VerificationPlanRecordRequest",
  "type": "object"
}
