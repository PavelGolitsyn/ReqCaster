{
  "$id": "https://spec-speaker.local/schemas/v1/SearchRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "baselineId": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "correlationId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "cursor": {
      "maxLength": 2048,
      "minLength": 1,
      "type": "string"
    },
    "filters": {
      "additionalProperties": false,
      "properties": {
        "allocation": {
          "items": {
            "maxLength": 160,
            "type": "string"
          },
          "maxItems": 64,
          "type": "array",
          "uniqueItems": true
        },
        "category": {
          "items": {
            "maxLength": 64,
            "type": "string"
          },
          "maxItems": 32,
          "type": "array",
          "uniqueItems": true
        },
        "criticality": {
          "items": {
            "maxLength": 64,
            "type": "string"
          },
          "maxItems": 32,
          "type": "array",
          "uniqueItems": true
        },
        "document": {
          "items": {
            "enum": [
              "business",
              "software"
            ]
          },
          "maxItems": 2,
          "type": "array",
          "uniqueItems": true
        },
        "hasExternalReference": {
          "type": "boolean"
        },
        "hasSuspectLinks": {
          "type": "boolean"
        },
        "id": {
          "items": {
            "pattern": "^(BR|SR)-[0-9]{6}$",
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "level": {
          "items": {
            "enum": [
              "business",
              "software"
            ]
          },
          "maxItems": 2,
          "type": "array",
          "uniqueItems": true
        },
        "missingSource": {
          "type": "boolean"
        },
        "missingVerification": {
          "type": "boolean"
        },
        "owner": {
          "items": {
            "maxLength": 256,
            "type": "string"
          },
          "maxItems": 64,
          "type": "array",
          "uniqueItems": true
        },
        "priority": {
          "items": {
            "maxLength": 64,
            "type": "string"
          },
          "maxItems": 32,
          "type": "array",
          "uniqueItems": true
        },
        "release": {
          "items": {
            "maxLength": 160,
            "type": "string"
          },
          "maxItems": 64,
          "type": "array",
          "uniqueItems": true
        },
        "status": {
          "items": {
            "maxLength": 64,
            "type": "string"
          },
          "maxItems": 32,
          "type": "array",
          "uniqueItems": true
        },
        "tags": {
          "items": {
            "maxLength": 160,
            "type": "string"
          },
          "maxItems": 64,
          "type": "array",
          "uniqueItems": true
        },
        "updatedFrom": {
          "maxLength": 32,
          "type": "string"
        },
        "updatedTo": {
          "maxLength": 32,
          "type": "string"
        },
        "verificationMethod": {
          "items": {
            "maxLength": 64,
            "type": "string"
          },
          "maxItems": 32,
          "type": "array",
          "uniqueItems": true
        },
        "version": {
          "items": {
            "minimum": 1,
            "type": "integer"
          },
          "maxItems": 64,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [],
      "type": "object"
    },
    "includeRetired": {
      "type": "boolean"
    },
    "limit": {
      "maximum": 100,
      "minimum": 1,
      "type": "integer"
    },
    "preset": {
      "enum": [
        "summary",
        "authoring",
        "verification",
        "full"
      ]
    },
    "projection": {
      "items": {
        "pattern": "^[A-Za-z][A-Za-z0-9.]{0,63}$",
        "type": "string"
      },
      "maxItems": 32,
      "type": "array",
      "uniqueItems": true
    },
    "query": {
      "maxLength": 1000,
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "sort": {
      "additionalProperties": false,
      "properties": {
        "direction": {
          "enum": [
            "asc",
            "desc"
          ]
        },
        "field": {
          "enum": [
            "id",
            "level",
            "category",
            "status",
            "priority",
            "criticality",
            "owner",
            "release",
            "updatedAt",
            "version",
            "relevance"
          ]
        }
      },
      "required": [
        "field",
        "direction"
      ],
      "type": "object"
    }
  },
  "required": [
    "schemaVersion",
    "correlationId"
  ],
  "title": "SearchRequest",
  "type": "object"
}
