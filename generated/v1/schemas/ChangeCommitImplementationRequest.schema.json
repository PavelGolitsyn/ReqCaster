{
  "$id": "https://speccaster.local/schemas/v1/ChangeCommitImplementationRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "correlationId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "idempotencyKey": {
      "maxLength": 128,
      "minLength": 8,
      "type": "string"
    },
    "previewToken": {
      "maxLength": 2048,
      "minLength": 32,
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0.0"
    }
  },
  "required": [
    "schemaVersion",
    "correlationId",
    "idempotencyKey",
    "previewToken"
  ],
  "title": "ChangeCommitImplementationRequest",
  "type": "object"
}
