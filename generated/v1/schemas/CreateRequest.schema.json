{
  "$id": "https://spec-speaker.local/schemas/v1/CreateRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "correlationId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "draft": {
      "additionalProperties": false,
      "properties": {
        "acceptanceCriteria": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 128,
          "type": "array"
        },
        "allocation": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "type": "array",
          "uniqueItems": true
        },
        "category": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "level": {
          "enum": [
            "business",
            "software"
          ]
        },
        "shortLabel": {
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        },
        "statement": {
          "maxLength": 10000,
          "minLength": 1,
          "type": "string"
        },
        "status": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "level",
        "statement",
        "category"
      ],
      "type": "object"
    },
    "expectedRepositoryRevision": {
      "minimum": 0,
      "type": "integer"
    },
    "idempotencyKey": {
      "maxLength": 128,
      "minLength": 8,
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0.0"
    }
  },
  "required": [
    "schemaVersion",
    "correlationId",
    "idempotencyKey",
    "expectedRepositoryRevision",
    "draft"
  ],
  "title": "CreateRequest",
  "type": "object"
}
