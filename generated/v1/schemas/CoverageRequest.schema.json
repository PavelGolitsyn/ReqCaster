{
  "$id": "https://spec-speaker.local/schemas/v1/CoverageRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "correlationId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "cursor": {
      "maxLength": 2048,
      "minLength": 1,
      "type": "string"
    },
    "gap": {
      "enum": [
        "missing",
        "stale",
        "failed",
        "waived",
        "not-applicable"
      ]
    },
    "level": {
      "enum": [
        "business",
        "software"
      ]
    },
    "limit": {
      "maximum": 100,
      "minimum": 1,
      "type": "integer"
    },
    "schemaVersion": {
      "const": "1.0.0"
    }
  },
  "required": [
    "schemaVersion",
    "correlationId",
    "gap"
  ],
  "title": "CoverageRequest",
  "type": "object"
}
