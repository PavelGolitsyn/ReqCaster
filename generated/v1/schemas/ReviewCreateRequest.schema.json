{
  "$id": "https://speccaster.local/schemas/v1/ReviewCreateRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "correlationId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "expectedRepositoryRevision": {
      "minimum": 0,
      "type": "integer"
    },
    "idempotencyKey": {
      "maxLength": 128,
      "minLength": 8,
      "type": "string"
    },
    "participants": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 128,
      "type": "array",
      "uniqueItems": true
    },
    "purpose": {
      "maxLength": 4000,
      "minLength": 1,
      "type": "string"
    },
    "relationshipIds": {
      "items": {
        "pattern": "^RL-[0-9]{6}$",
        "type": "string"
      },
      "maxItems": 1000,
      "type": "array",
      "uniqueItems": true
    },
    "requirementIds": {
      "items": {
        "pattern": "^(BR|SR)-[0-9]{6}$",
        "type": "string"
      },
      "maxItems": 500,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "reviewType": {
      "enum": [
        "informal",
        "formal"
      ]
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "scope": {
      "additionalProperties": true,
      "maxProperties": 32,
      "properties": {},
      "required": [],
      "type": "object"
    },
    "title": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "correlationId",
    "idempotencyKey",
    "expectedRepositoryRevision",
    "title",
    "requirementIds",
    "reviewType",
    "purpose"
  ],
  "title": "ReviewCreateRequest",
  "type": "object"
}
