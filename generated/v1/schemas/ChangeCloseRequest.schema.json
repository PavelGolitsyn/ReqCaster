{
  "$id": "https://spec-speaker.local/schemas/v1/ChangeCloseRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "changeId": {
      "pattern": "^CH-[0-9]{6}$",
      "type": "string"
    },
    "correlationId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "evidenceReferences": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "status": {
            "enum": [
              "planned",
              "passed",
              "failed",
              "accepted",
              "not_applicable"
            ]
          },
          "type": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "uri": {
            "maxLength": 2048,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "id",
          "type"
        ],
        "type": "object"
      },
      "maxItems": 256,
      "type": "array"
    },
    "expectedRepositoryRevision": {
      "minimum": 0,
      "type": "integer"
    },
    "expectedVersion": {
      "minimum": 1,
      "type": "integer"
    },
    "idempotencyKey": {
      "maxLength": 128,
      "minLength": 8,
      "type": "string"
    },
    "rationale": {
      "maxLength": 4000,
      "minLength": 1,
      "type": "string"
    },
    "residualExceptions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "approver": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "expiresAt": {
            "maxLength": 32,
            "minLength": 20,
            "type": "string"
          },
          "rationale": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "reviewAt": {
            "maxLength": 32,
            "minLength": 20,
            "type": "string"
          },
          "scope": {
            "items": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 32,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": [
          "scope",
          "rationale",
          "approver"
        ],
        "type": "object"
      },
      "maxItems": 64,
      "type": "array"
    },
    "schemaVersion": {
      "const": "1.0.0"
    }
  },
  "required": [
    "schemaVersion",
    "correlationId",
    "idempotencyKey",
    "expectedRepositoryRevision",
    "changeId",
    "expectedVersion",
    "authority",
    "rationale",
    "evidenceReferences"
  ],
  "title": "ChangeCloseRequest",
  "type": "object"
}
