{
  "$id": "https://speccaster.local/schemas/v1/LinkRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "correlationId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "expectedRepositoryRevision": {
      "minimum": 0,
      "type": "integer"
    },
    "idempotencyKey": {
      "maxLength": 128,
      "minLength": 8,
      "type": "string"
    },
    "rationale": {
      "maxLength": 4000,
      "minLength": 1,
      "type": "string"
    },
    "relationshipType": {
      "maxLength": 64,
      "minLength": 1,
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "source": {
      "additionalProperties": false,
      "properties": {
        "artifactType": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "externalId": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "externalVersion": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "id": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "system": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "systemOfRecord": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "uri": {
          "maxLength": 2048,
          "minLength": 1,
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "sourceExpectedVersion": {
      "minimum": 1,
      "type": "integer"
    },
    "sourceId": {
      "pattern": "^(BR|SR)-[0-9]{6}$",
      "type": "string"
    },
    "target": {
      "additionalProperties": false,
      "properties": {
        "artifactType": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "externalId": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "externalVersion": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "id": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "system": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "systemOfRecord": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "uri": {
          "maxLength": 2048,
          "minLength": 1,
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "targetExpectedVersion": {
      "minimum": 1,
      "type": "integer"
    },
    "targetId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "correlationId",
    "idempotencyKey",
    "expectedRepositoryRevision",
    "relationshipType"
  ],
  "title": "LinkRequest",
  "type": "object"
}
