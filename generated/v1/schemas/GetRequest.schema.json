{
  "$id": "https://speccaster.local/schemas/v1/GetRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "baselineId": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "correlationId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "id": {
      "pattern": "^(BR|SR)-[0-9]{6}$",
      "type": "string"
    },
    "ids": {
      "items": {
        "pattern": "^(BR|SR)-[0-9]{6}$",
        "type": "string"
      },
      "maxItems": 50,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "includeRetired": {
      "type": "boolean"
    },
    "preset": {
      "enum": [
        "summary",
        "authoring",
        "verification",
        "full"
      ]
    },
    "projection": {
      "items": {
        "pattern": "^[A-Za-z][A-Za-z0-9.]{0,63}$",
        "type": "string"
      },
      "maxItems": 32,
      "type": "array",
      "uniqueItems": true
    },
    "relationships": {
      "enum": [
        "none",
        "counts",
        "summary"
      ]
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "version": {
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "schemaVersion",
    "correlationId"
  ],
  "title": "GetRequest",
  "type": "object"
}
