{
  "$id": "https://spec-speaker.local/schemas/v1/AiProposalAcceptRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "acceptedPatch": {
      "additionalProperties": false,
      "properties": {
        "acceptanceCriteria": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "maxLength": 64,
                "minLength": 1,
                "type": "string"
              },
              "text": {
                "maxLength": 2000,
                "minLength": 1,
                "type": "string"
              },
              "verificationMethod": {
                "maxLength": 64,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "id",
              "text"
            ],
            "type": "object"
          },
          "maxItems": 128,
          "type": "array"
        },
        "category": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "criticality": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "customAttributes": {
          "additionalProperties": true,
          "maxProperties": 64,
          "properties": {},
          "required": [],
          "type": "object"
        },
        "owner": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "priority": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "rationale": {
          "maxLength": 4000,
          "minLength": 1,
          "type": "string"
        },
        "shortLabel": {
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        },
        "sourceReferences": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "title": {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              },
              "type": {
                "maxLength": 64,
                "minLength": 1,
                "type": "string"
              },
              "uri": {
                "maxLength": 2048,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "type",
              "uri"
            ],
            "type": "object"
          },
          "maxItems": 128,
          "type": "array"
        },
        "statement": {
          "maxLength": 10000,
          "minLength": 1,
          "type": "string"
        },
        "verificationMethods": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [],
      "type": "object"
    },
    "correlationId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "expectedRepositoryRevision": {
      "minimum": 0,
      "type": "integer"
    },
    "expectedVersion": {
      "minimum": 1,
      "type": "integer"
    },
    "id": {
      "pattern": "^(BR|SR)-[0-9]{6}$",
      "type": "string"
    },
    "idempotencyKey": {
      "maxLength": 128,
      "minLength": 8,
      "type": "string"
    },
    "proposedContentHash": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "rationale": {
      "maxLength": 4000,
      "minLength": 1,
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0.0"
    }
  },
  "required": [
    "schemaVersion",
    "correlationId",
    "idempotencyKey",
    "expectedRepositoryRevision",
    "id",
    "expectedVersion",
    "proposedContentHash",
    "rationale"
  ],
  "title": "AiProposalAcceptRequest",
  "type": "object"
}
