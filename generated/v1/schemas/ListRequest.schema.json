{
  "$id": "https://spec-speaker.local/schemas/v1/ListRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "correlationId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "cursor": {
      "maxLength": 2048,
      "minLength": 1,
      "type": "string"
    },
    "filters": {
      "additionalProperties": false,
      "properties": {
        "level": {
          "enum": [
            "business",
            "software"
          ]
        },
        "status": {
          "maxLength": 64,
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    },
    "limit": {
      "maximum": 100,
      "minimum": 1,
      "type": "integer"
    },
    "projection": {
      "items": {
        "pattern": "^[A-Za-z][A-Za-z0-9.]{0,63}$",
        "type": "string"
      },
      "maxItems": 32,
      "type": "array",
      "uniqueItems": true
    },
    "schemaVersion": {
      "const": "1.0.0"
    }
  },
  "required": [
    "schemaVersion",
    "correlationId"
  ],
  "title": "ListRequest",
  "type": "object"
}
