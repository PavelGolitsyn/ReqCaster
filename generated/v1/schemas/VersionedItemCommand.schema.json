{
  "$id": "https://speccaster.local/schemas/v1/VersionedItemCommand.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "correlationId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "expectedRepositoryRevision": {
      "minimum": 0,
      "type": "integer"
    },
    "expectedVersion": {
      "minimum": 1,
      "type": "integer"
    },
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "idempotencyKey": {
      "maxLength": 128,
      "minLength": 8,
      "type": "string"
    },
    "rationale": {
      "maxLength": 4000,
      "minLength": 1,
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0.0"
    }
  },
  "required": [
    "schemaVersion",
    "correlationId",
    "idempotencyKey",
    "expectedRepositoryRevision",
    "id",
    "expectedVersion",
    "rationale"
  ],
  "title": "VersionedItemCommand",
  "type": "object"
}
