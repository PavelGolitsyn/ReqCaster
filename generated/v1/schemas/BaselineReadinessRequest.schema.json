{
  "$id": "https://spec-speaker.local/schemas/v1/BaselineReadinessRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "correlationId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "requirementIds": {
      "items": {
        "pattern": "^(BR|SR)-[0-9]{6}$",
        "type": "string"
      },
      "maxItems": 500,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "schemaVersion": {
      "const": "1.0.0"
    }
  },
  "required": [
    "schemaVersion",
    "correlationId",
    "requirementIds"
  ],
  "title": "BaselineReadinessRequest",
  "type": "object"
}
