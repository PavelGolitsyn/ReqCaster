{
  "$id": "https://speccaster.local/schemas/v1/BaselineReadinessRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "correlationId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "exceptions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "authority": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "code": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "expiresAt": {
            "maxLength": 32,
            "minLength": 1,
            "type": "string"
          },
          "rationale": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "relationshipId": {
            "pattern": "^RL-[0-9]{6}$",
            "type": "string"
          },
          "requirementId": {
            "pattern": "^(BR|SR)-[0-9]{6}$",
            "type": "string"
          },
          "reviewAt": {
            "maxLength": 32,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "code",
          "rationale",
          "authority"
        ],
        "type": "object"
      },
      "maxItems": 128,
      "type": "array"
    },
    "exclusions": {
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 128,
      "type": "array"
    },
    "requirementIds": {
      "items": {
        "pattern": "^(BR|SR)-[0-9]{6}$",
        "type": "string"
      },
      "maxItems": 500,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "scope": {
      "additionalProperties": true,
      "maxProperties": 32,
      "properties": {},
      "required": [],
      "type": "object"
    }
  },
  "required": [
    "schemaVersion",
    "correlationId",
    "requirementIds"
  ],
  "title": "BaselineReadinessRequest",
  "type": "object"
}
