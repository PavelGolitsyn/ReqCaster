{
  "$id": "https://spec-speaker.local/schemas/v1/ImportPreviewRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "content": {
      "maxLength": 5000000,
      "minLength": 1,
      "type": "string"
    },
    "correlationId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "expectedRepositoryRevision": {
      "minimum": 0,
      "type": "integer"
    },
    "format": {
      "enum": [
        "json",
        "csv",
        "reqif"
      ]
    },
    "idempotencyKey": {
      "maxLength": 128,
      "minLength": 8,
      "type": "string"
    },
    "mappingVersion": {
      "maxLength": 64,
      "minLength": 1,
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0.0"
    }
  },
  "required": [
    "schemaVersion",
    "correlationId",
    "idempotencyKey",
    "expectedRepositoryRevision",
    "format",
    "content",
    "mappingVersion"
  ],
  "title": "ImportPreviewRequest",
  "type": "object"
}
