{
  "$id": "https://speccaster.local/schemas/v1/ChangeGetRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "changeId": {
      "pattern": "^CH-[0-9]{6}$",
      "type": "string"
    },
    "correlationId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0.0"
    }
  },
  "required": [
    "schemaVersion",
    "correlationId",
    "changeId"
  ],
  "title": "ChangeGetRequest",
  "type": "object"
}
