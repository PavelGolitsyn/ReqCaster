{
  "$id": "https://spec-speaker.local/schemas/v1/OperationResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "correlationId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "data": {},
    "page": {
      "additionalProperties": false,
      "properties": {
        "nextCursor": {
          "maxLength": 2048,
          "minLength": 1,
          "type": "string"
        },
        "returnedCount": {
          "minimum": 0,
          "type": "integer"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "returnedCount",
        "truncated"
      ],
      "type": "object"
    },
    "repositoryRevision": {
      "minimum": 0,
      "type": "integer"
    },
    "schemaVersion": {
      "const": "1.0.0"
    }
  },
  "required": [
    "schemaVersion",
    "repositoryRevision",
    "correlationId",
    "data"
  ],
  "title": "OperationResponse",
  "type": "object"
}
