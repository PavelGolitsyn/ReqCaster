{
  "$id": "https://spec-speaker.local/schemas/v1/PossibleTransitionsRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "correlationId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "evidenceReferences": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "status": {
            "enum": [
              "planned",
              "passed",
              "failed",
              "accepted",
              "not_applicable"
            ]
          },
          "type": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "uri": {
            "maxLength": 2048,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "id",
          "type"
        ],
        "type": "object"
      },
      "maxItems": 128,
      "type": "array"
    },
    "expectedVersion": {
      "minimum": 1,
      "type": "integer"
    },
    "id": {
      "pattern": "^(BR|SR)-[0-9]{6}$",
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "toStatus": {
      "maxLength": 64,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "correlationId",
    "id"
  ],
  "title": "PossibleTransitionsRequest",
  "type": "object"
}
